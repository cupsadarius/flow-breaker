# Copy to .env (gitignored) and fill in. Never commit .env.
WEB_ADDR=:8091
WEB_ALLOWED_HOSTS=<intel-mac>.<tailnet>.ts.net
WEB_ALLOWED_USERS=<your Tailscale login>
FLOW_BREAKER_URL=https://rpi.<tailnet>.ts.net
NTFY_URL=<ntfy base URL on the Pi>
NTFY_TOPIC=flow
NTFY_TOKEN=
VAPID_SUBJECT=mailto:<your email>
